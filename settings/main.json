{
  ".source.git-config": {
    "editor": {
      "commentStart": "# "
    }
  },
  ".text.git-commit": {
    "editor": {
      "preferredLineLength": 72
    }
  },
  ".source.gitignore, .source.gitattributes": {
    "editor": {
      "commentStart": "# ",
      "commentDelimiters": {
        "line": "#"
      }
    }
  }
}

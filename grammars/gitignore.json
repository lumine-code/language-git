{
  "name": "Gitignore",
  "scopeName": "source.gitignore",
  "type": "tree-sitter",
  "parser": "tree-sitter-gitignore",
  "injectionNames": ["gitignore"],
  // Every one of these is gitignore syntax — glob patterns, `!` re-inclusion,
  // `#` comments — whatever tool reads it. `.dockerignore` came from
  // language-dockerfile, where a pattern line is not a Dockerfile instruction.
  // Both spellings are listed on purpose: the dotted form matches the real
  // dotfile (and scores a character higher for it), the bare form matches a
  // qualified `<name>.gitignore`.
  "fileTypes": [
    ".gitignore",
    "gitignore",
    ".dockerignore",
    "dockerignore",
    ".eslintignore",
    "eslintignore",
    ".npmignore",
    "npmignore",
    ".prettierignore",
    "prettierignore"
  ],
  "comments": {
    "start": "# "
  },
  "treeSitter": {
    "parserSource": "github:shunsambongi/tree-sitter-gitignore#f4685bf11ac466dd278449bcfe5fd014e94aa504",
    "wasmBuildTool": "tree-sitter-cli#v0.26.13",
    "grammar": "gitignore.wasm",
    "highlightsQuery": "gitignore-highlights.scm"
  }
}
